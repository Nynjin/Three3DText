{
  "name": "benchmark-3d-text",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "predev": "npm run build:lib",
    "build": "npm run build:lib && next build --webpack",
    "start": "next start",
    "build:lib": "npm run build -w @itowns/labels",
    "watch:lib": "npm run watch -w @itowns/labels",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run build:lib && tsc --noEmit",
    "notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "@itowns/labels": "^0.1.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/uikit": "^1.0.60",
    "next": "^16.3.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stats-gl": "^4.2.3",
    "three": "^0.182.0",
    "troika-three-text": "^0.52.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.182.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-jsdoc": "^63.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8"
  },
  "license": "(CECILL-B OR MIT)",
  "workspaces": [
    "packages/*"
  ]
}
